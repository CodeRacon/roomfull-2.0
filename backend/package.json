{
	"name": "backend",
	"version": "1.0.0",
	"main": "dist/server.js",
	"scripts": {
		"dev": "tsx watch src/server.ts",
		"dev:hot": "nodemon --watch src --watch prisma/schema.prisma --ext ts,prisma --exec \"npm run prisma:generate && tsx src/server.ts\"",
		"build": "tsc -p tsconfig.json",
		"start": "node dist/server.js",
		"lint": "../node_modules/.bin/biome check .",
		"test": "node --import tsx --test tests/*.test.ts",
		"format": "../node_modules/.bin/biome format . --write",
		"format:check": "../node_modules/.bin/biome format .",
		"prisma:generate": "prisma generate",
		"prisma:migrate:dev": "prisma migrate dev",
		"prisma:migrate:deploy": "prisma migrate deploy",
		"prisma:localize-units": "tsx prisma/localize-existing-units.ts",
		"prisma:seed": "prisma db seed"
	},
	"prisma": {
		"seed": "tsx prisma/seed.ts"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"description": "",
	"dependencies": {
		"@prisma/client": "^6.17.1",
		"bcryptjs": "^3.0.3",
		"cors": "^2.8.6",
		"dotenv": "^17.4.2",
		"express": "^5.2.1",
		"helmet": "^8.1.0",
		"jsonwebtoken": "^9.0.3",
		"morgan": "^1.10.1",
		"swagger-ui-express": "^5.0.1"
	},
	"devDependencies": {
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/morgan": "^1.9.10",
		"@types/node": "^25.6.0",
		"@types/swagger-ui-express": "^4.1.8",
		"nodemon": "^3.1.14",
		"prisma": "^6.17.1",
		"tsx": "^4.21.0",
		"typescript": "^6.0.3"
	}
}
