meta {
  name: Auth Register
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "{{userName}}",
    "email": "{{userEmail}}",
    "password": "{{userPassword}}"
  }
}

settings {
  encodeUrl: true
}
