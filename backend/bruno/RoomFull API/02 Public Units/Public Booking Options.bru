meta {
  name: Public Booking Options
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/public/booking-options
  body: none
  auth: inherit
}

script:post-response {
  let json = res.getBody();
  if (typeof json === "string") {
    try {
      json = JSON.parse(json);
    } catch (e) {
      json = null;
    }
  }

  const hotDeskOption = json?.bookingOptions?.find(
    (option) => option.key === "HOT_DESK"
  );

  if (hotDeskOption?.unitType?.id) {
    bru.setVar("hotDeskUnitTypeId", hotDeskOption.unitType.id);
  }
}

tests {
  test("booking options expose duration limits", function () {
    expect(res.getStatus()).to.equal(200);

    const json = res.getBody();
    const options = json && json.bookingOptions ? json.bookingOptions : [];

    expect(
      options.every(
        (option) =>
          typeof option.unitType.minDurationMinutes === "number" &&
          typeof option.unitType.maxDurationMinutes === "number"
      )
    ).to.equal(true);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
