meta {
  name: Customer Unit Day Bookings
  type: http
  seq: 15
}

get {
  url: {{baseUrl}}/api/units/{{unitId}}/day-bookings?date=2027-01-18
  body: none
  auth: inherit
}

headers {
  Authorization: Bearer {{customerToken}}
}

tests {
  test("returns unit day bookings", function () {
    expect(res.getStatus()).to.equal(200);

    const json = res.getBody();
    const dayBookings = json && json.dayBookings ? json.dayBookings : null;

    expect(dayBookings.unitId).to.equal(bru.getVar("unitId"));
    expect(dayBookings.date).to.equal("2027-01-18");
    expect(Array.isArray(dayBookings.bookedIntervals)).to.equal(true);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
