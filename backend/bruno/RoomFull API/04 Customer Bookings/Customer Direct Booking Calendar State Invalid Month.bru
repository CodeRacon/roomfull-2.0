meta {
  name: Customer Direct Booking Calendar State Invalid Month
  type: http
  seq: 16
}

get {
  url: {{baseUrl}}/api/units/{{unitId}}/calendar-state?month=not-a-month
  body: none
  auth: inherit
}

headers {
  Authorization: Bearer {{customerToken}}
}

tests {
  test("rejects invalid month query", function () {
    expect(res.getStatus()).to.equal(400);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
