meta {
  name: Customer Booking Context Hot Desk
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/api/bookings/context?unitType={{bookingUnitType}}&areaId={{areaId}}
  body: none
  auth: inherit
}

headers {
  Authorization: Bearer {{customerToken}}
}

tests {
  test("returns hot desk auto assign booking context", function () {
    expect(res.getStatus()).to.equal(200);

    const json = res.getBody();
    const bookingContext = json && json.bookingContext ? json.bookingContext : null;

    expect(bookingContext.mode).to.equal("AUTO_ASSIGN");
    expect(bookingContext.unitType.name).to.equal("HOT_DESK");
    expect(bookingContext.area.id).to.equal(bru.getVar("areaId"));
    expect(bookingContext.area.seatCount).to.be.greaterThan(0);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
