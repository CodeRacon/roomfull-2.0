meta {
  name: Customer Create Booking (Auto Assign Hot Desk)
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/api/bookings
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{customerToken}}
}

body:json {
  {
    "areaId": "{{areaId}}",
    "unitType": "{{bookingUnitType}}",
    "start": "{{bookingStart}}",
    "end": "{{bookingEnd}}"
  }
}

script:post-response {
  let json = res.getBody();
  if (typeof json === "string") {
    try {
      json = JSON.parse(json);
    } catch (e) {
      json = null;
    }
  }

  if (json && json.booking && json.booking.id) {
    bru.setVar("bookingId", json.booking.id);
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
