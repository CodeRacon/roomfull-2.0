meta {
  name: Auth Login
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{userEmail}}",
    "password": "{{userPassword}}"
  }
}


script:post-response {
  let json = res.getBody();
  if (typeof json === "string") {
    try {
      json = JSON.parse(json);
    } catch (e) {
      json = null;
    }
  }

  if (json && json.token) {
    bru.setVar("customerToken", json.token);
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
