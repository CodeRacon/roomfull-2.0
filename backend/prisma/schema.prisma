generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER @map("customer")
  ADMIN    @map("admin")

  @@map("user_role")
}

enum BookingStatus {
  ACTIVE    @map("active")
  CANCELLED @map("cancelled")

  @@map("booking_status")
}

enum ContactRequestType {
  QUESTION
  FEEDBACK
  CRITICISM

  @@map("contact_request_type")
}

enum UnitTypeName {
  HOT_DESK
  BOOTH
  TEAM_ROOM
  MEETING_ROOM
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         UserRole  @default(CUSTOMER)
  isDemo       Boolean   @default(false) @map("is_demo")
  demoExpiresAt DateTime? @map("demo_expires_at")
  bookings     Booking[]
  contactRequests ContactRequest[]
  teams        Team[]
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("users")
}

model Team {
  id      String       @id @default(cuid())
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  members TeamMember[]

  userId  String @map("user_id")
  name    String
  nameKey String @map("name_key")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, nameKey], map: "teams_user_id_name_key_key")
  @@map("teams")
}

model TeamMember {
  id   String @id @default(cuid())
  team Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  teamId String @map("team_id")
  name   String
  email  String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([teamId, email], map: "team_members_team_id_email_key")
  @@map("team_members")
}

model Area {
  id          String         @id @default(cuid())
  name        String         @unique
  description String?
  descriptionDe String?       @map("description_de")
  descriptionEn String?       @map("description_en")
  isActive    Boolean        @default(true) @map("is_active")
  units       BookableUnit[]
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  @@map("areas")
}

model UnitType {
  id                 String         @id @default(cuid())
  name               UnitTypeName   @unique
  minDurationMinutes Int            @map("min_duration_minutes")
  maxDurationMinutes Int            @map("max_duration_minutes")
  units              BookableUnit[]
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  @@map("unit_types")
}

model BookableUnit {
  id          String    @id @default(cuid())
  name        String
  description String
  descriptionDe String? @map("description_de")
  descriptionEn String? @map("description_en")
  capacity    Int
  isActive    Boolean   @default(true) @map("is_active")
  displayOrder Int      @default(0) @map("display_order")

  unitType   UnitType   @relation(fields: [unitTypeId], references: [id])
  area       Area?      @relation(fields: [areaId], references: [id])
  bookings   Booking[]

  unitTypeId String     @map("unit_type_id")
  areaId     String?    @map("area_id")

  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  @@index([areaId, unitTypeId, displayOrder], map: "bookable_units_area_type_order_idx")
  @@map("bookable_units")
}

model Booking {
  id String @id @default(cuid())

  user User @relation(fields: [userId], references: [id])
  unit BookableUnit @relation(fields: [unitId], references: [id])

  userId String @map("user_id")
  unitId String @map("unit_id")

  startTime DateTime      @map("start_time")
  endTime   DateTime      @map("end_time")
  status    BookingStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([unitId, status, startTime, endTime], map: "bookings_unit_status_time_idx")
  @@map("bookings")
}

model ContactRequest {
  id String @id @default(cuid())

  user User @relation(fields: [userId], references: [id])

  userId  String             @map("user_id")
  type    ContactRequestType
  message String
  isRead  Boolean            @default(false) @map("is_read")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isRead, createdAt], map: "contact_requests_read_created_idx")
  @@index([type, createdAt], map: "contact_requests_type_created_idx")
  @@map("contact_requests")
}
