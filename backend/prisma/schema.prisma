generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER @map("customer")
  ADMIN    @map("admin")

  @@map("user_role")
}

enum BookingStatus {
  ACTIVE    @map("active")
  CANCELLED @map("cancelled")

  @@map("booking_status")
}

enum UnitTypeName {
  HOT_DESK
  BOOTH
  TEAM_ROOM
  MEETING_ROOM
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         UserRole  @default(CUSTOMER)
  bookings     Booking[]
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("users")
}

model Area {
  id          String         @id @default(cuid())
  name        String         @unique
  description String?
  isActive    Boolean        @default(true) @map("is_active")
  units       BookableUnit[]
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  @@map("areas")
}

model UnitType {
  id                 String         @id @default(cuid())
  name               UnitTypeName   @unique
  minDurationMinutes Int            @map("min_duration_minutes")
  maxDurationMinutes Int            @map("max_duration_minutes")
  units              BookableUnit[]
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  @@map("unit_types")
}

model BookableUnit {
  id          String    @id @default(cuid())
  name        String
  description String
  capacity    Int
  isActive    Boolean   @default(true) @map("is_active")
  displayOrder Int      @default(0) @map("display_order")

  unitType   UnitType   @relation(fields: [unitTypeId], references: [id])
  area       Area?      @relation(fields: [areaId], references: [id])
  bookings   Booking[]

  unitTypeId String     @map("unit_type_id")
  areaId     String?    @map("area_id")

  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  @@index([areaId, unitTypeId, displayOrder], map: "bookable_units_area_type_order_idx")
  @@map("bookable_units")
}

model Booking {
  id String @id @default(cuid())

  user User @relation(fields: [userId], references: [id])
  unit BookableUnit @relation(fields: [unitId], references: [id])

  userId String @map("user_id")
  unitId String @map("unit_id")

  startTime DateTime      @map("start_time")
  endTime   DateTime      @map("end_time")
  status    BookingStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([unitId, status, startTime, endTime], map: "bookings_unit_status_time_idx")
  @@map("bookings")
}
