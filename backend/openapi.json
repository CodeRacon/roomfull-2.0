				"required": ["unitType", "bookingCount"]
			},
			"BookingCancellationStats": {
				"type": "object",
				"properties": {
					"activeBookings": { "type": "integer", "minimum": 0 },
					"cancelledBookings": { "type": "integer", "minimum": 0 },
					"totalBookings": { "type": "integer", "minimum": 0 },
					"cancellationRate": { "type": "number", "minimum": 0, "maximum": 1 }
				},
				"required": [
					"activeBookings",
					"cancelledBookings",
					"totalBookings",
					"cancellationRate"
				]
			},
			"BookingDemandAnalytics": {
				"type": "object",
				"properties": {
					"cancellationStats": {
						"$ref": "#/components/schemas/BookingCancellationStats"
					},
					"dateRange": {
						"type": "object",
						"properties": {
							"from": { "type": "string", "format": "date" },
							"to": { "type": "string", "format": "date" }
						},
						"required": ["from", "to"]
					},
					"granularity": {
						"type": "string",
						"enum": ["day"]
					},
					"metric": {
						"type": "string",
						"enum": ["activeBookingsByStartDate"]
					},
					"demandByUnitType": {
						"type": "array",
						"items": {
							"$ref": "#/components/schemas/BookingDemandUnitTypePoint"
						}
					},
					"trend": {
						"type": "array",
						"items": { "$ref": "#/components/schemas/BookingDemandTrendPoint" }
					}
				},
				"required": [
					"cancellationStats",
					"dateRange",
					"demandByUnitType",
					"granularity",
					"metric",
					"trend"
				]
			},
			"BookingDemandAnalyticsResponse": {
				"type": "object",
				"properties": {
					"bookingDemand": {
						"$ref": "#/components/schemas/BookingDemandAnalytics"
					}
				},
				"required": ["bookingDemand"]
			},
			"BookedInterval": {
				"type": "object",
				"properties": {
					"start": { "type": "string", "format": "date-time" },
					"end": { "type": "string", "format": "date-time" }
				},
				"required": ["start", "end"]
			},
			"UnitDayBookings": {
				"type": "object",
				"properties": {
					"date": { "type": "string", "format": "date" },
					"unitId": { "type": "string" },
					"bookedIntervals": {
						"type": "array",
						"items": { "$ref": "#/components/schemas/BookedInterval" }
					}
				},
				"required": ["date", "unitId", "bookedIntervals"]
			},
			"UnitDayBookingsResponse": {
				"type": "object",
				"properties": {
					"dayBookings": { "$ref": "#/components/schemas/UnitDayBookings" }
				},
				"required": ["dayBookings"]
			},
			"ApiError": {
				"type": "object",
				"properties": {
					"error": {
						"type": "object",
						"properties": {
							"message": { "type": "string" },
							"details": {}
						},
						"required": ["message"]
					}
				},
				"required": ["error"]
			}
		},
		"responses": {
			"BadRequest": {
				"description": "Ungültige Eingabe",
				"content": {
					"application/json": {
						"schema": { "$ref": "#/components/schemas/ApiError" }
					}
				}
			},
			"Unauthorized": {
				"description": "Nicht autorisiert",
				"content": {
					"application/json": {
						"schema": { "$ref": "#/components/schemas/ApiError" }
					}
				}
			},
			"Forbidden": {
				"description": "Keine Berechtigung",
				"content": {
					"application/json": {
						"schema": { "$ref": "#/components/schemas/ApiError" }
					}
				}
			},
			"NotFound": {
				"description": "Nicht gefunden",
				"content": {
					"application/json": {
						"schema": { "$ref": "#/components/schemas/ApiError" }
					}
				}
			},
			"Conflict": {
