{
	"openapi": "3.0.3",
	"info": {
		"title": "RoomFull Backend API",
		"version": "0.3.0",
		"description": "Auth-, Units- und Booking-Slice für RoomFull 2.0 (Area/UnitType/BookableUnit-Modell)."
	},
	"servers": [
		{
			"url": "http://localhost:4000/api"
		}
	],
	"tags": [
		{ "name": "Auth" },
		{ "name": "Public Units" },
		{ "name": "Admin Units" },
		{ "name": "Customer Bookings" },
		{ "name": "Admin Bookings" }
	],
	"paths": {
		"/auth/register": {
			"post": {
				"tags": ["Auth"],
				"summary": "Neuen User registrieren",
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": { "$ref": "#/components/schemas/RegisterRequest" }
						}
					}
				},
				"responses": {
					"201": {
						"description": "Registrierung erfolgreich",
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/AuthResponse" }
							}
						}
					},
					"400": { "$ref": "#/components/responses/BadRequest" },
					"409": { "$ref": "#/components/responses/Conflict" }
				}
			}
		},
		"/auth/login": {
			"post": {
				"tags": ["Auth"],
				"summary": "User einloggen",
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": { "$ref": "#/components/schemas/LoginRequest" }
						}
					}
				},
				"responses": {
					"200": {
						"description": "Login erfolgreich",
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/AuthResponse" }
							}
						}
					},
					"400": { "$ref": "#/components/responses/BadRequest" },
					"401": { "$ref": "#/components/responses/Unauthorized" }
				}
			}
		},
		"/auth/me": {
			"get": {
				"tags": ["Auth"],
				"summary": "Eingeloggten User laden",
				"security": [{ "bearerAuth": [] }],
				"responses": {
					"200": {
						"description": "User-Profil",
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"properties": {
										"user": { "$ref": "#/components/schemas/PublicUser" }
									},
									"required": ["user"]
								}
							}
						}
					},
					"401": { "$ref": "#/components/responses/Unauthorized" },
					"404": { "$ref": "#/components/responses/NotFound" }
				}
			}
		},
		"/public/units": {
			"get": {
				"tags": ["Public Units"],
				"summary": "Aktive Units laden",
				"responses": {
					"200": {
						"description": "Liste aktiver Units",
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/UnitListResponse" }
							}
						}
					}
				}
			}
		},
		"/public/units/{unitId}": {
			"get": {
				"tags": ["Public Units"],
				"summary": "Aktive Unit per ID laden",
				"parameters": [
					{
						"name": "unitId",
						"in": "path",
						"required": true,
						"schema": { "type": "string" }
					}
				],
				"responses": {
					"200": {
						"description": "Unitdetails",
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/UnitResponse" }
							}
						}
					},
					"400": { "$ref": "#/components/responses/BadRequest" },
					"404": { "$ref": "#/components/responses/NotFound" }
				}
			}
		},
		"/public/units/{unitId}/availability": {
			"get": {
				"tags": ["Public Units"],
				"summary": "Verfügbarkeit einer Unit prüfen",
				"parameters": [
					{
						"name": "unitId",
						"in": "path",
						"required": true,
						"schema": { "type": "string" }
					},
					{
						"name": "start",
						"in": "query",
						"required": true,
						"schema": { "type": "string", "format": "date-time" }
					},
					{
						"name": "end",
						"in": "query",
						"required": true,
						"schema": { "type": "string", "format": "date-time" }
					}
				],
				"responses": {
					"200": {
						"description": "Verfügbarkeitsstatus",
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"properties": {
										"availability": { "$ref": "#/components/schemas/UnitAvailability" }
									},
									"required": ["availability"]
								}
							}
						}
					},
					"400": { "$ref": "#/components/responses/BadRequest" },
					"404": { "$ref": "#/components/responses/NotFound" }
				}
			}
		},
		"/admin/units": {
			"post": {
				"tags": ["Admin Units"],
				"summary": "Neue Unit erstellen",
				"security": [{ "bearerAuth": [] }],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": { "$ref": "#/components/schemas/CreateUnitRequest" }
						}
					}
				},
				"responses": {
					"201": {
						"description": "Unit erfolgreich erstellt",
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/UnitResponse" }
							}
						}
					},
					"400": { "$ref": "#/components/responses/BadRequest" },
					"401": { "$ref": "#/components/responses/Unauthorized" },
					"403": { "$ref": "#/components/responses/Forbidden" },
					"404": { "$ref": "#/components/responses/NotFound" }
				}
			}
		},
		"/admin/units/{unitId}": {
			"put": {
				"tags": ["Admin Units"],
				"summary": "Unit aktualisieren",
				"security": [{ "bearerAuth": [] }],
				"parameters": [
					{
						"name": "unitId",
						"in": "path",
						"required": true,
						"schema": { "type": "string" }
					}
				],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": { "$ref": "#/components/schemas/UpdateUnitRequest" }
						}
					}
				},
				"responses": {
					"200": {
						"description": "Unit erfolgreich aktualisiert",
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/UnitResponse" }
							}
						}
					},
					"400": { "$ref": "#/components/responses/BadRequest" },
					"401": { "$ref": "#/components/responses/Unauthorized" },
					"403": { "$ref": "#/components/responses/Forbidden" },
					"404": { "$ref": "#/components/responses/NotFound" }
				}
			}
		},
		"/admin/units/{unitId}/deactivate": {
			"patch": {
				"tags": ["Admin Units"],
				"summary": "Unit deaktivieren",
				"security": [{ "bearerAuth": [] }],
				"parameters": [
					{
						"name": "unitId",
						"in": "path",
						"required": true,
						"schema": { "type": "string" }
					}
				],
				"responses": {
					"200": {
						"description": "Unit erfolgreich deaktiviert",
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/UnitResponse" }
							}
						}
					},
					"400": { "$ref": "#/components/responses/BadRequest" },
					"401": { "$ref": "#/components/responses/Unauthorized" },
					"403": { "$ref": "#/components/responses/Forbidden" },
					"404": { "$ref": "#/components/responses/NotFound" }
				}
			}
		},
		"/bookings": {
			"post": {
				"tags": ["Customer Bookings"],
				"summary": "Neue Buchung erstellen",
				"security": [{ "bearerAuth": [] }],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": { "$ref": "#/components/schemas/CreateBookingRequest" }
						}
					}
				},
				"responses": {
					"201": {
						"description": "Buchung erfolgreich erstellt",
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/BookingResponse" }
							}
						}
					},
					"400": { "$ref": "#/components/responses/BadRequest" },
					"401": { "$ref": "#/components/responses/Unauthorized" },
					"404": { "$ref": "#/components/responses/NotFound" },
					"409": { "$ref": "#/components/responses/Conflict" }
				}
			}
		},
		"/me/bookings": {
			"get": {
				"tags": ["Customer Bookings"],
				"summary": "Eigene Buchungen laden",
				"security": [{ "bearerAuth": [] }],
				"responses": {
					"200": {
						"description": "Eigene Buchungen",
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/BookingListResponse" }
							}
						}
					},
					"401": { "$ref": "#/components/responses/Unauthorized" }
				}
			}
		},
		"/bookings/{bookingId}": {
			"delete": {
				"tags": ["Customer Bookings"],
				"summary": "Eigene zukünftige Buchung stornieren",
				"security": [{ "bearerAuth": [] }],
				"parameters": [
					{
						"name": "bookingId",
						"in": "path",
						"required": true,
						"schema": { "type": "string" }
					}
				],
				"responses": {
					"200": {
						"description": "Buchung erfolgreich storniert",
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/BookingResponse" }
							}
						}
					},
					"400": { "$ref": "#/components/responses/BadRequest" },
					"401": { "$ref": "#/components/responses/Unauthorized" },
					"403": { "$ref": "#/components/responses/Forbidden" },
					"404": { "$ref": "#/components/responses/NotFound" },
					"409": { "$ref": "#/components/responses/Conflict" }
				}
			}
		},
		"/admin/bookings": {
			"get": {
				"tags": ["Admin Bookings"],
				"summary": "Alle Buchungen laden (Admin)",
				"security": [{ "bearerAuth": [] }],
				"responses": {
					"200": {
						"description": "Alle Buchungen",
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/BookingListResponse" }
							}
						}
					},
					"401": { "$ref": "#/components/responses/Unauthorized" },
					"403": { "$ref": "#/components/responses/Forbidden" }
				}
			}
		}
	},
	"components": {
		"securitySchemes": {
			"bearerAuth": {
				"type": "http",
				"scheme": "bearer",
				"bearerFormat": "JWT"
			}
		},
		"schemas": {
			"RegisterRequest": {
				"type": "object",
				"properties": {
					"name": { "type": "string", "example": "Max Mustermann" },
					"email": {
						"type": "string",
						"format": "email",
						"example": "max@example.com"
					},
					"password": { "type": "string", "minLength": 8, "example": "secret123" }
				},
				"required": ["name", "email", "password"]
			},
			"LoginRequest": {
				"type": "object",
				"properties": {
					"email": {
						"type": "string",
						"format": "email",
						"example": "max@example.com"
					},
					"password": { "type": "string", "example": "secret123" }
				},
				"required": ["email", "password"]
			},
			"PublicUser": {
				"type": "object",
				"properties": {
					"id": { "type": "string", "example": "ckxyz123456" },
					"name": { "type": "string", "example": "Max Mustermann" },
					"email": {
						"type": "string",
						"format": "email",
						"example": "max@example.com"
					},
					"role": { "type": "string", "enum": ["CUSTOMER", "ADMIN"], "example": "CUSTOMER" },
					"createdAt": { "type": "string", "format": "date-time" }
				},
				"required": ["id", "name", "email", "role", "createdAt"]
			},
			"AuthResponse": {
				"type": "object",
				"properties": {
					"token": { "type": "string" },
					"user": { "$ref": "#/components/schemas/PublicUser" }
				},
				"required": ["token", "user"]
			},
			"Unit": {
				"type": "object",
				"properties": {
					"id": { "type": "string" },
					"name": { "type": "string" },
					"description": { "type": "string" },
					"capacity": { "type": "integer" },
					"isActive": { "type": "boolean" },
					"displayOrder": { "type": "integer", "minimum": 0 },
					"unitTypeId": { "type": "string" },
					"areaId": { "type": "string", "nullable": true },
					"createdAt": { "type": "string", "format": "date-time" },
					"updatedAt": { "type": "string", "format": "date-time" }
				},
				"required": [
					"id",
					"name",
					"description",
					"capacity",
					"isActive",
					"displayOrder",
					"unitTypeId",
					"createdAt",
					"updatedAt"
				]
			},
			"UnitResponse": {
				"type": "object",
				"properties": {
					"unit": { "$ref": "#/components/schemas/Unit" }
				},
				"required": ["unit"]
			},
			"UnitListResponse": {
				"type": "object",
				"properties": {
					"units": {
						"type": "array",
						"items": { "$ref": "#/components/schemas/Unit" }
					}
				},
				"required": ["units"]
			},
			"UnitAvailability": {
				"type": "object",
				"properties": {
					"unitId": { "type": "string" },
					"startTime": { "type": "string", "format": "date-time" },
					"endTime": { "type": "string", "format": "date-time" },
					"isAvailable": { "type": "boolean" }
				},
				"required": ["unitId", "startTime", "endTime", "isAvailable"]
			},
			"CreateUnitRequest": {
				"type": "object",
				"properties": {
					"name": { "type": "string" },
					"description": { "type": "string" },
					"capacity": { "type": "integer", "minimum": 1 },
					"isActive": { "type": "boolean" },
					"displayOrder": { "type": "integer", "minimum": 0 },
					"unitTypeId": { "type": "string" },
					"areaId": { "type": "string" }
				},
				"required": ["name", "description", "capacity", "unitTypeId"]
			},
			"UpdateUnitRequest": {
				"type": "object",
				"properties": {
					"name": { "type": "string" },
					"description": { "type": "string" },
					"capacity": { "type": "integer", "minimum": 1 },
					"isActive": { "type": "boolean" },
					"displayOrder": { "type": "integer", "minimum": 0 },
					"unitTypeId": { "type": "string" },
					"areaId": { "type": "string" }
				}
			},
			"CreateBookingRequest": {
				"oneOf": [
					{
						"type": "object",
						"properties": {
							"unitId": { "type": "string" },
							"start": { "type": "string", "format": "date-time" },
							"end": { "type": "string", "format": "date-time" }
						},
						"required": ["unitId", "start", "end"]
					},
					{
						"type": "object",
						"properties": {
							"areaId": { "type": "string" },
							"unitType": { "type": "string", "enum": ["HOT_DESK"] },
							"start": { "type": "string", "format": "date-time" },
							"end": { "type": "string", "format": "date-time" }
						},
						"required": ["areaId", "unitType", "start", "end"]
					}
				]
			},
			"Booking": {
				"type": "object",
				"properties": {
					"id": { "type": "string" },
					"userId": { "type": "string" },
					"unitId": { "type": "string" },
					"startTime": { "type": "string", "format": "date-time" },
					"endTime": { "type": "string", "format": "date-time" },
					"status": { "type": "string", "enum": ["ACTIVE", "CANCELLED"] },
					"createdAt": { "type": "string", "format": "date-time" },
					"updatedAt": { "type": "string", "format": "date-time" }
				},
				"required": [
					"id",
					"userId",
					"unitId",
					"startTime",
					"endTime",
					"status",
					"createdAt",
					"updatedAt"
				]
			},
			"BookingResponse": {
				"type": "object",
				"properties": {
					"booking": { "$ref": "#/components/schemas/Booking" }
				},
				"required": ["booking"]
			},
			"BookingListResponse": {
				"type": "object",
				"properties": {
					"bookings": {
						"type": "array",
						"items": { "$ref": "#/components/schemas/Booking" }
					}
				},
				"required": ["bookings"]
			},
			"ApiError": {
				"type": "object",
				"properties": {
					"error": {
						"type": "object",
						"properties": {
							"message": { "type": "string" },
							"details": {}
						},
						"required": ["message"]
					}
				},
				"required": ["error"]
			}
		},
		"responses": {
			"BadRequest": {
				"description": "Ungültige Eingabe",
				"content": {
					"application/json": {
						"schema": { "$ref": "#/components/schemas/ApiError" }
					}
				}
			},
			"Unauthorized": {
				"description": "Nicht autorisiert",
				"content": {
					"application/json": {
						"schema": { "$ref": "#/components/schemas/ApiError" }
					}
				}
			},
			"Forbidden": {
				"description": "Keine Berechtigung",
				"content": {
					"application/json": {
						"schema": { "$ref": "#/components/schemas/ApiError" }
					}
				}
			},
			"NotFound": {
				"description": "Nicht gefunden",
				"content": {
					"application/json": {
						"schema": { "$ref": "#/components/schemas/ApiError" }
					}
				}
			},
			"Conflict": {
				"description": "Konflikt",
				"content": {
					"application/json": {
						"schema": { "$ref": "#/components/schemas/ApiError" }
					}
				}
			}
		}
	}
}
