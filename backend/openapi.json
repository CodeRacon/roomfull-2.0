{
	"openapi": "3.0.3",
	"info": {
		"title": "RoomFull Backend API",
		"version": "0.3.0",
		"description": "Auth-, Units- und Booking-Slice für RoomFull 2.0 (Area/UnitType/BookableUnit-Modell)."
	},
	"servers": [
		{
			"url": "http://localhost:4000/api"
		}
	],
	"tags": [
		{ "name": "Auth" },
		{ "name": "Public Units" },
		{ "name": "Admin Units" },
		{ "name": "Customer Bookings" },
		{ "name": "Admin Bookings" },
		{ "name": "Customer Contact" },
		{ "name": "Admin Contact" }
	],
	"paths": {
		"/auth/register": {
			"post": {
				"tags": ["Auth"],
				"summary": "Neuen User registrieren",
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": { "$ref": "#/components/schemas/RegisterRequest" }
						}
					}
				},
				"responses": {
					"201": {
						"description": "Registrierung erfolgreich",
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/AuthResponse" }
							}
						}
					},
					"400": { "$ref": "#/components/responses/BadRequest" },
					"409": { "$ref": "#/components/responses/Conflict" }
				}
			}
		},
		"/auth/login": {
			"post": {
				"tags": ["Auth"],
				"summary": "User einloggen",
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": { "$ref": "#/components/schemas/LoginRequest" }
						}
					}
				},
				"responses": {
					"200": {
						"description": "Login erfolgreich",
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/AuthResponse" }
							}
						}
					},
					"400": { "$ref": "#/components/responses/BadRequest" },
					"401": { "$ref": "#/components/responses/Unauthorized" }
				}
			}
		},
		"/auth/me": {
			"get": {
				"tags": ["Auth"],
				"summary": "Eingeloggten User laden",
				"security": [{ "bearerAuth": [] }],
				"responses": {
					"200": {
						"description": "User-Profil",
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"properties": {
										"user": { "$ref": "#/components/schemas/PublicUser" }
									},
									"required": ["user"]
								}
							}
						}
					},
					"401": { "$ref": "#/components/responses/Unauthorized" },
					"404": { "$ref": "#/components/responses/NotFound" }
				}
			}
		},
		"/contact-requests": {
			"post": {
				"tags": ["Customer Contact"],
				"summary": "Customer Contact Request absenden",
				"description": "Speichert eine Customer-only Kontaktanfrage ohne E-Mail-Versand. Neue Anfragen starten global ungelesen.",
				"security": [{ "bearerAuth": [] }],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/CreateContactRequestRequest"
							}
						}
					}
				},
				"responses": {
					"201": {
						"description": "Contact Request gespeichert",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ContactRequestResponse"
								}
							}
						}
					},
					"400": { "$ref": "#/components/responses/BadRequest" },
					"401": { "$ref": "#/components/responses/Unauthorized" },
					"403": { "$ref": "#/components/responses/Forbidden" }
				}
			}
		},
		"/public/units": {
			"get": {
				"tags": ["Public Units"],
				"summary": "Aktive Units laden",
				"parameters": [
					{
						"name": "unitType",
						"in": "query",
						"required": false,
						"schema": {
							"type": "string",
							"enum": ["HOT_DESK", "BOOTH", "TEAM_ROOM", "MEETING_ROOM"]
						},
						"description": "Optionaler Filter nach UnitType"
					}
				],
				"responses": {
					"200": {
						"description": "Liste aktiver Units",
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/UnitListResponse" }
							}
						}
					},
					"400": { "$ref": "#/components/responses/BadRequest" }
				}
			}
		},
		"/public/booking-options": {
			"get": {
				"tags": ["Public Units"],
				"summary": "Public BookingOptions laden",
				"description": "Liefert die Customer-facing BookingOptions für den Homepage-Einstieg. Der Endpoint arbeitet ohne Zeitraum und beschreibt grundsätzliche Buchbarkeit.",
				"responses": {
					"200": {
						"description": "Liste öffentlicher BookingOptions",
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/BookingOptionListResponse" }
							}
						}
					}
				}
			}
		},
		"/public/units/{unitId}": {
			"get": {
				"tags": ["Public Units"],
				"summary": "Aktive Unit per ID laden",
				"parameters": [
					{
						"name": "unitId",
						"in": "path",
						"required": true,
						"schema": { "type": "string" }
					}
				],
				"responses": {
					"200": {
						"description": "Unitdetails",
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/UnitResponse" }
							}
						}
					},
					"400": { "$ref": "#/components/responses/BadRequest" },
					"404": { "$ref": "#/components/responses/NotFound" }
				}
			}
		},
		"/public/units/{unitId}/availability": {
			"get": {
				"tags": ["Public Units"],
				"summary": "Verfügbarkeit einer Unit prüfen",
				"parameters": [
					{
						"name": "unitId",
						"in": "path",
						"required": true,
						"schema": { "type": "string" }
					},
					{
						"name": "start",
						"in": "query",
						"required": true,
						"schema": { "type": "string", "format": "date-time" }
					},
					{
						"name": "end",
						"in": "query",
						"required": true,
						"schema": { "type": "string", "format": "date-time" }
					}
				],
				"responses": {
					"200": {
						"description": "Verfügbarkeitsstatus",
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"properties": {
										"availability": { "$ref": "#/components/schemas/UnitAvailability" }
									},
									"required": ["availability"]
								}
							}
						}
					},
					"400": { "$ref": "#/components/responses/BadRequest" },
					"404": { "$ref": "#/components/responses/NotFound" }
				}
			}
		},
		"/admin/units": {
			"get": {
				"tags": ["Admin Units"],
				"summary": "Units für Admin-Inventar laden",
				"security": [{ "bearerAuth": [] }],
				"parameters": [
					{
						"name": "status",
						"in": "query",
						"required": false,
						"schema": {
							"type": "string",
							"enum": ["active", "deactivated", "all"],
							"default": "active"
						}
					},
					{
						"name": "unitType",
						"in": "query",
						"required": false,
						"schema": {
							"type": "string",
							"enum": ["HOT_DESK", "BOOTH", "TEAM_ROOM", "MEETING_ROOM"]
						}
					},
					{
						"name": "search",
						"in": "query",
						"required": false,
						"schema": { "type": "string" },
						"description": "Einfache Suche nach Unit-Name"
					}
				],
				"responses": {
					"200": {
						"description": "Admin-Inventarliste",
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/UnitListResponse" }
							}
						}
					},
					"400": { "$ref": "#/components/responses/BadRequest" },
					"401": { "$ref": "#/components/responses/Unauthorized" },
					"403": { "$ref": "#/components/responses/Forbidden" }
				}
			},
			"post": {
				"tags": ["Admin Units"],
				"summary": "Neue Unit erstellen",
				"security": [{ "bearerAuth": [] }],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": { "$ref": "#/components/schemas/CreateUnitRequest" }
						}
					}
				},
				"responses": {
					"201": {
						"description": "Unit erfolgreich erstellt",
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/UnitResponse" }
							}
						}
					},
					"400": { "$ref": "#/components/responses/BadRequest" },
					"401": { "$ref": "#/components/responses/Unauthorized" },
					"403": { "$ref": "#/components/responses/Forbidden" },
					"404": { "$ref": "#/components/responses/NotFound" }
				}
			}
		},
		"/admin/units/context": {
			"get": {
				"tags": ["Admin Units"],
				"summary": "Auswahlwerte für Admin-Unit-Formular laden",
				"security": [{ "bearerAuth": [] }],
				"responses": {
					"200": {
						"description": "Admin-Unit-Formular-Kontext",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/AdminUnitContextResponse"
								}
							}
						}
					},
					"401": { "$ref": "#/components/responses/Unauthorized" },
					"403": { "$ref": "#/components/responses/Forbidden" }
				}
			}
		},
		"/admin/units/{unitId}": {
			"put": {
				"tags": ["Admin Units"],
				"summary": "Unit aktualisieren",
				"security": [{ "bearerAuth": [] }],
				"parameters": [
					{
						"name": "unitId",
						"in": "path",
						"required": true,
						"schema": { "type": "string" }
					}
				],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": { "$ref": "#/components/schemas/UpdateUnitRequest" }
						}
					}
				},
				"responses": {
					"200": {
						"description": "Unit erfolgreich aktualisiert",
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/UnitResponse" }
							}
						}
					},
					"400": { "$ref": "#/components/responses/BadRequest" },
					"401": { "$ref": "#/components/responses/Unauthorized" },
					"403": { "$ref": "#/components/responses/Forbidden" },
					"404": { "$ref": "#/components/responses/NotFound" }
				}
			}
		},
		"/admin/units/{unitId}/deactivate": {
			"patch": {
				"tags": ["Admin Units"],
				"summary": "Unit deaktivieren",
				"security": [{ "bearerAuth": [] }],
				"parameters": [
					{
						"name": "unitId",
						"in": "path",
						"required": true,
						"schema": { "type": "string" }
					}
				],
				"responses": {
					"200": {
						"description": "Unit erfolgreich deaktiviert",
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/UnitResponse" }
							}
						}
					},
					"400": { "$ref": "#/components/responses/BadRequest" },
					"401": { "$ref": "#/components/responses/Unauthorized" },
					"403": { "$ref": "#/components/responses/Forbidden" },
					"404": { "$ref": "#/components/responses/NotFound" }
				}
			}
		},
		"/bookings/context": {
			"get": {
				"tags": ["Customer Bookings"],
				"summary": "Booking Context für Create Booking Page laden",
				"description": "Auth-required Endpoint für `/bookings/new`. Akzeptiert entweder `unitId` für Direktbuchung oder `unitType=HOT_DESK&areaId=...` für Hot-Desk-Auto-Assign.",
				"security": [{ "bearerAuth": [] }],
				"parameters": [
					{
						"name": "unitId",
						"in": "query",
						"required": false,
						"schema": { "type": "string" },
						"description": "Konkrete Unit für Direct Booking"
					},
					{
						"name": "unitType",
						"in": "query",
						"required": false,
						"schema": { "type": "string", "enum": ["HOT_DESK"] },
						"description": "UnitType für Auto-Assign; in V1 nur HOT_DESK"
					},
					{
						"name": "areaId",
						"in": "query",
						"required": false,
						"schema": { "type": "string" },
						"description": "Area für Hot-Desk-Auto-Assign"
					}
				],
				"responses": {
					"200": {
						"description": "Booking Context",
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/BookingContextResponse" }
							}
						}
					},
					"400": { "$ref": "#/components/responses/BadRequest" },
					"401": { "$ref": "#/components/responses/Unauthorized" },
					"404": { "$ref": "#/components/responses/NotFound" }
				}
			}
		},
		"/bookings/availability": {
			"get": {
				"tags": ["Customer Bookings"],
				"summary": "Booking Availability für einen Tag laden",
				"description": "Auth-required Endpoint für die Create Booking Page. Akzeptiert entweder `unitId` für Direct Booking oder `areaId + unitType=HOT_DESK` für Hot-Desk-Auto-Assign. Liefert lokale HH:mm Availability Slots und blockierende Intervalle für den gewählten Tag.",
				"security": [{ "bearerAuth": [] }],
				"parameters": [
					{
						"name": "date",
						"in": "query",
						"required": true,
						"schema": {
							"type": "string",
							"format": "date",
							"example": "2027-01-18"
						}
					},
					{
						"name": "unitId",
						"in": "query",
						"required": false,
						"schema": { "type": "string" },
						"description": "Konkrete Unit für Direct Booking"
					},
					{
						"name": "areaId",
						"in": "query",
						"required": false,
						"schema": { "type": "string" },
						"description": "Area für Hot-Desk-Auto-Assign"
					},
					{
						"name": "unitType",
						"in": "query",
						"required": false,
						"schema": { "type": "string", "enum": ["HOT_DESK"] },
						"description": "UnitType für Auto-Assign; in V1 nur HOT_DESK"
					}
				],
				"responses": {
					"200": {
						"description": "Booking Availability für den Tag",
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/BookingAvailabilityResponse" }
							}
						}
					},
					"400": { "$ref": "#/components/responses/BadRequest" },
					"401": { "$ref": "#/components/responses/Unauthorized" },
					"404": { "$ref": "#/components/responses/NotFound" }
				}
			}
		},
		"/bookings": {
			"post": {
				"tags": ["Customer Bookings"],
				"summary": "Neue Buchung erstellen",
				"security": [{ "bearerAuth": [] }],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": { "$ref": "#/components/schemas/CreateBookingRequest" }
						}
					}
				},
				"responses": {
					"201": {
						"description": "Buchung erfolgreich erstellt",
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/BookingResponse" }
							}
						}
					},
					"400": { "$ref": "#/components/responses/BadRequest" },
					"401": { "$ref": "#/components/responses/Unauthorized" },
					"404": { "$ref": "#/components/responses/NotFound" },
					"409": { "$ref": "#/components/responses/Conflict" }
				}
			}
		},
		"/me/bookings": {
			"get": {
				"tags": ["Customer Bookings"],
				"summary": "Eigene Buchungen laden",
				"security": [{ "bearerAuth": [] }],
				"responses": {
					"200": {
						"description": "Eigene Buchungen",
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/BookingListResponse" }
							}
						}
					},
					"401": { "$ref": "#/components/responses/Unauthorized" }
				}
			}
		},
		"/units/{unitId}/day-bookings": {
			"get": {
				"tags": ["Customer Bookings"],
				"summary": "Belegte Intervalle einer Unit für einen Tag laden",
				"description": "Auth-required Endpoint für den BookingFlow. Liefert nur aktive blockierende Intervalle, keine User-/Owner-Daten.",
				"security": [{ "bearerAuth": [] }],
				"parameters": [
					{
						"name": "unitId",
						"in": "path",
						"required": true,
						"schema": { "type": "string" }
					},
					{
						"name": "date",
						"in": "query",
						"required": true,
						"schema": {
							"type": "string",
							"format": "date",
							"example": "2027-01-18"
						}
					}
				],
				"responses": {
					"200": {
						"description": "Belegte Intervalle für den Tag",
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/UnitDayBookingsResponse" }
							}
						}
					},
					"400": { "$ref": "#/components/responses/BadRequest" },
					"401": { "$ref": "#/components/responses/Unauthorized" },
					"404": { "$ref": "#/components/responses/NotFound" }
				}
			}
		},
		"/bookings/{bookingId}": {
			"delete": {
				"tags": ["Customer Bookings"],
				"summary": "Eigene zukünftige Buchung stornieren",
				"security": [{ "bearerAuth": [] }],
				"parameters": [
					{
						"name": "bookingId",
						"in": "path",
						"required": true,
						"schema": { "type": "string" }
					}
				],
				"responses": {
					"200": {
						"description": "Buchung erfolgreich storniert",
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/BookingResponse" }
							}
						}
					},
					"400": { "$ref": "#/components/responses/BadRequest" },
					"401": { "$ref": "#/components/responses/Unauthorized" },
					"403": { "$ref": "#/components/responses/Forbidden" },
					"404": { "$ref": "#/components/responses/NotFound" },
					"409": { "$ref": "#/components/responses/Conflict" }
				}
			}
		},
		"/admin/bookings": {
			"get": {
				"tags": ["Admin Bookings"],
				"summary": "Buchungen gefiltert laden (Admin)",
				"security": [{ "bearerAuth": [] }],
				"parameters": [
					{
						"name": "status",
						"in": "query",
						"schema": {
							"type": "string",
							"enum": ["upcoming", "today", "completed", "cancelled", "all"],
							"default": "upcoming"
						}
					},
					{
						"name": "from",
						"in": "query",
						"schema": {
							"type": "string",
							"format": "date",
							"example": "2027-01-01"
						}
					},
					{
						"name": "to",
						"in": "query",
						"schema": {
							"type": "string",
							"format": "date",
							"example": "2027-01-31"
						}
					},
					{
						"name": "limit",
						"in": "query",
						"schema": {
							"type": "integer",
							"minimum": 1,
							"maximum": 500,
							"default": 100
						}
					},
					{
						"name": "search",
						"in": "query",
						"description": "Sucht ausschließlich nach Customer-Name oder Customer-E-Mail.",
						"schema": {
							"type": "string",
							"example": "max@example.com"
						}
					}
				],
				"responses": {
					"200": {
						"description": "Alle Buchungen",
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/AdminBookingListResponse" }
							}
						}
					},
					"401": { "$ref": "#/components/responses/Unauthorized" },
					"403": { "$ref": "#/components/responses/Forbidden" }
				}
			}
		},
		"/admin/contact-requests": {
			"get": {
				"tags": ["Admin Contact"],
				"summary": "Customer Contact Requests laden",
				"description": "Liefert eingegangene Customer Contact Requests für die Admin Contact Inbox.",
				"security": [{ "bearerAuth": [] }],
				"parameters": [
					{
						"name": "type",
						"in": "query",
						"schema": {
							"type": "string",
							"enum": ["QUESTION", "FEEDBACK", "CRITICISM"]
						}
					},
					{
						"name": "readState",
						"in": "query",
						"schema": {
							"type": "string",
							"enum": ["all", "read", "unread"],
							"default": "all"
						}
					},
					{
						"name": "sort",
						"in": "query",
						"schema": {
							"type": "string",
							"enum": ["received_desc", "received_asc"],
							"default": "received_desc"
						}
					}
				],
				"responses": {
					"200": {
						"description": "Kontaktanfragen",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/AdminContactRequestListResponse"
								}
							}
						}
					},
					"400": { "$ref": "#/components/responses/BadRequest" },
					"401": { "$ref": "#/components/responses/Unauthorized" },
					"403": { "$ref": "#/components/responses/Forbidden" }
				}
			}
		},
		"/admin/contact-requests/unread-count": {
			"get": {
				"tags": ["Admin Contact"],
				"summary": "Ungelesene Customer Contact Requests zaehlen",
				"description": "Liefert die globale Anzahl ungelesener Customer Contact Requests fuer dezente Admin-Hinweise.",
				"security": [{ "bearerAuth": [] }],
				"responses": {
					"200": {
						"description": "Anzahl ungelesener Kontaktanfragen",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/AdminContactRequestUnreadCountResponse"
								}
							}
						}
					},
					"401": { "$ref": "#/components/responses/Unauthorized" },
					"403": { "$ref": "#/components/responses/Forbidden" }
				}
			}
		},
		"/admin/contact-requests/{contactRequestId}/read": {
			"patch": {
				"tags": ["Admin Contact"],
				"summary": "Customer Contact Request als gelesen markieren",
				"security": [{ "bearerAuth": [] }],
				"parameters": [
					{
						"name": "contactRequestId",
						"in": "path",
						"required": true,
						"schema": { "type": "string" }
					}
				],
				"responses": {
					"200": {
						"description": "Kontaktanfrage aktualisiert",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/AdminContactRequestResponse"
								}
							}
						}
					},
					"400": { "$ref": "#/components/responses/BadRequest" },
					"401": { "$ref": "#/components/responses/Unauthorized" },
					"403": { "$ref": "#/components/responses/Forbidden" },
					"404": { "$ref": "#/components/responses/NotFound" }
				}
			}
		},
		"/admin/analytics/booking-demand": {
			"get": {
				"tags": ["Admin Analytics"],
				"summary": "Nachfrageverlauf für Admin Analytics laden",
				"description": "Liefert aktive Bookings gruppiert nach Booking-Startdatum. Ohne Zeitraum nutzt der Endpoint 30 Tage zurück und 30 Tage voraus.",
				"security": [{ "bearerAuth": [] }],
				"parameters": [
					{
						"name": "from",
						"in": "query",
						"schema": {
							"type": "string",
							"format": "date",
							"example": "2027-01-01"
						}
					},
					{
						"name": "to",
						"in": "query",
						"schema": {
							"type": "string",
							"format": "date",
							"example": "2027-01-31"
						}
					}
				],
				"responses": {
					"200": {
						"description": "Nachfrageverlauf",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/BookingDemandAnalyticsResponse"
								}
							}
						}
					},
					"400": { "$ref": "#/components/responses/BadRequest" },
					"401": { "$ref": "#/components/responses/Unauthorized" },
					"403": { "$ref": "#/components/responses/Forbidden" }
				}
			}
		}
	},
